# nginx site config for the SkillBridge SPA on Cloud Run.
# ${PORT} is substituted at container start (see Dockerfile NGINX_ENVSUBST_FILTER).
server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Gzip text assets on the fly.
    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json
                    application/xml image/svg+xml font/woff2;

    # Same-origin API: proxy /api/* to the NestJS backend (Cloud Run).
    # The browser only ever talks to THIS origin → no CORS needed on the BE,
    # and the refresh-token cookie becomes first-party (survives browser
    # third-party-cookie blocking). Mirrored in dev by Vite's server.proxy.
    location /api/ {
        # Re-resolve the Cloud Run hostname periodically (its IPs rotate);
        # a variable in proxy_pass forces per-request resolution.
        resolver 8.8.8.8 1.1.1.1 valid=300s;
        set $api_backend "skillbridge-be-973344038436.asia-southeast1.run.app";

        proxy_pass https://$api_backend;
        proxy_ssl_server_name on;
        proxy_set_header Host $api_backend;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Scope any host-bound Set-Cookie back to our domain.
        proxy_cookie_domain $api_backend $host;

        # Cloud Run cold-starts (~5-15s) — don't cut the first request short.
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }

    # Content-hashed build assets (Vite emits hashed filenames) → cache forever.
    # pdf.js emits its worker as .mjs. nginx:alpine may serve .mjs as
    # application/octet-stream, which Chrome rejects for module workers.
    location ~* ^/assets/.*\.mjs$ {
        default_type application/javascript;
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    location /assets/ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # index.html must never be cached, so a new deploy is picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Runtime config (regenerated from env each boot) — must never be cached,
    # else a browser keeps stale config across deploys / env changes.
    location = /config.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Build-time version metadata — never cached so it always reflects the
    # current deploy. Safe to expose: no secrets, just version/sha/time.
    location = /version.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Content-Type "application/json";
    }

    # SPA fallback: any unknown path → index.html (React Router handles routing).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
