# Copy to .env and fill in what you need. All values are OPTIONAL —
# the app runs with sensible defaults (same-origin /api + public client ID).

# Base URL for the API. Leave EMPTY to call same-origin /api/* —
# proxied to the NestJS BE by Vite in dev (vite.config.ts server.proxy)
# and by nginx in production (nginx/default.conf.template).
# Only set this to call a backend directly (CORS then applies).
VITE_API_URL=

# Where the dev-server /api proxy points. Default: Render BE.
# Point at a local NestJS to develop against it:
# VITE_DEV_API_PROXY=http://localhost:3002
VITE_DEV_API_PROXY=

# Google OAuth client ID (public, not a secret). Default: project client ID.
VITE_GOOGLE_CLIENT_ID=
