# Copy to .env and fill in what you need. All values are OPTIONAL —
# the app runs with sensible defaults (same-origin /api + public client ID).
#
# ── How config resolves (src/lib/runtime-config.ts) ──
#  1. RUNTIME: window.__APP_CONFIG__ from Cloud Run env (envsubst at container
#     start). On the FE Cloud Run service set PLAIN names — API_URL, GOOGLE_CLIENT_ID
#     — to change config WITHOUT rebuilding the image (one image, many envs).
#  2. BUILD-TIME: the VITE_* vars below, baked by `npm run build` (this .env).
#  3. DEFAULT: a public fallback hardcoded in runtime-config.ts.
# The VITE_* vars are for LOCAL dev; production is driven by the Cloud Run env above.

# Base URL for the API. Leave EMPTY to call same-origin /api/* —
# proxied to the NestJS BE by Vite in dev (vite.config.ts server.proxy)
# and by nginx in production (nginx/default.conf.template).
# Only set this to call a backend directly (CORS then applies).
VITE_API_URL=

# Where the dev-server /api proxy points. Default: Cloud Run BE.
# Point at a local NestJS to develop against it:
# VITE_DEV_API_PROXY=http://localhost:3002
VITE_DEV_API_PROXY=

# Google OAuth client ID (public, not a secret). Default: project client ID.
VITE_GOOGLE_CLIENT_ID=

# PostHog product analytics (public, not secrets).
# Production can set POSTHOG_PROJECT_TOKEN and POSTHOG_HOST as runtime env vars.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Version stamp (W28) ──────────────────────────────────────────────────────
# Auto-populated at build time by vite.config.ts if not set.
# CI can override these to match the deploy context.
# VITE_APP_VERSION=1.0.0
# VITE_GIT_SHA=abc1234...
# VITE_BUILD_TIME=2026-06-19T00:00:00Z

# ── Feature flags ────────────────────────────────────────────────────────────
# Story → Career Target (cold-start role inference + review/apply + readiness +
# project intake, W31–W34). Enable when the BE story endpoints are live.
# Local/build-time: set VITE_ below. Prod: set the RUNTIME env ENABLE_STORY_CAREER_TARGET
# on the FE Cloud Run service (no rebuild needed — rendered into config.js at boot).
# VITE_ENABLE_STORY_CAREER_TARGET=true

# Interview Experience v2 uses Realtime voice-orb, semantic VAD and the fast turn API.
# Keep disabled in production until voice/text/reconnect evals and latency SLO pass.
